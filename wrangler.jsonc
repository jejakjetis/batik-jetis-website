{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kampung-batik-jetis",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "kampung-batik-jetis" }
  ],
  // Database: Hyperdrive -> koneksi LANGSUNG Supabase (port 5432), bukan pooler.
  // Lokal: string koneksi dari env CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (.env).
  // TODO(deploy): ganti id dengan id Hyperdrive asli (lihat DEPLOY.md).
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "a774e35987b44a76a4c288ce6c464f5c" }
  ],
  "observability": { "enabled": true }
}
