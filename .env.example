# Lokal saja (dibaca prisma CLI, seed, test integrasi, dan wrangler/next dev). Server only.
# Koneksi LANGSUNG Supabase (port 5432), bukan pooler.
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# (tanpa tanda < > atau [ ]). Host db.* hanya IPv6; bila jaringan hanya IPv4, pakai
# string "Session pooler" (port 5432) dari tombol Connect di dashboard Supabase.
# JANGAN isi nilai asli di file ini — salin ke .env (diabaikan git).
DIRECT_URL=
# Simulasi binding Hyperdrive saat next dev / preview (nilai sama dengan DIRECT_URL).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
