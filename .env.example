# Lokal: salin ke .env (dibaca prisma CLI, seed, test) dan .env.local (Next.js).
# Produksi: isi di Vercel Project Settings > Environment Variables.

# --- Database (server only) ---
# Runtime: pooler Supabase mode transaction, port 6543
DATABASE_URL=
# Migrasi/seed: koneksi langsung, port 5432
DIRECT_URL=

# --- Supabase Auth (admin) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# daftar email admin, dipisah koma
ADMIN_EMAILS=

# --- Pemesanan ---
# nomor WA pengelola format 62…
BOOKING_WHATSAPP_NUMBER=
SITE_URL=
# Lokal pakai test key Cloudflare Turnstile (lihat README)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
